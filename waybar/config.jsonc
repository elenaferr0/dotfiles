{
  // Basic waybar configuration
  "exclusive": true,
  "passthrough": false,
  "height": 40,
  "margin": "6",
  "position": "top",
  
  // Module layout
  "modules-left": [
    "custom/menu",
    "custom/hostname", 
    "cpu",
    "memory",
    "wlr/workspaces"
  ],
  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "hyprland/language",
    "custom/tailscale",
    "network",
    "pulseaudio",
    "battery"
  ],

  // Workspaces configuration
  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  // Language switcher
  "hyprland/language": {
    "format": " {}",
    "format-en": "US",
    "format-it": "IT"
  },

  // Clock configuration
  "clock": {
    "interval": 1,
    "format": "{:%H:%M - %a %b %d }",
    "format-alt": "{:%Y-%m-%d %H:%M %z}",
    "on-click-left": "mode",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  // System monitoring
  "cpu": {
    "format": " {usage}%"
  },

  "memory": {
    "format": " {}%",
    "interval": 5
  },

  // Audio controls
  "pulseaudio": {
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭 0%",
    "format": "{icon} {volume}% {format_source}",
    "format-muted": "󰸈 0% {format_source}",
    "format-icons": {
      "default": [
          "󰕿",
          "󰖀",
          "󰕾"
      ]
    },
    "on-click": "pavucontrol"
  },

  // Battery indicator
  "battery": {
    "bat": "BAT0",
    "interval": 10,
    "format-icons": [
         "󰁺",
         "󰁻",
         "󰁼",
         "󰁽",
         "󰁾",
         "󰁿",
         "󰂀",
         "󰂁",
         "󰂂",
         "󰁹"
    ],
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%"
  },

  // Network status
  "network": {
    "interval": 3,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈁 Wired",
    "format-disconnected": "󱚼 Disconnected",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\nUp: {bandwidthUpBits}\nDown: {bandwidthDownBits}"
  },

  "custom/menu": {
    "format": "󰣇 {}"
  },

  "custom/tailscale": {
    "interval": 1,
    "exec": "~/.config/waybar/scripts/tailscale.sh",
    "format": "󰌆 {}",
  },

  // Hostname display
  "custom/hostname": {
    "exec": "echo \"$USER@$HOSTNAME\"",
    "on-click": "systemctl --user restart waybar",
    "format": "{}"
  }
}
