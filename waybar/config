{
  "exclusive": false,
  "passthrough": false,
  "height": 40,
  "margin": "6",
  "position": "top",
  "modules-left": [
    "custom/menu",
    "custom/hostname",
    "cpu",
    "memory",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "hyprland/language",
    "network",
    "pulseaudio",
    "battery"
  ],
  "hyprland/language": {
    "format": " {}",
    "format-en": "US",
    "format-it": "IT"
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M - %a %b %d }",
    "format-alt": "{:%Y-%m-%d %H:%M %z}",
    "on-click-left": "mode",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": " {usage}%"
  },
  "memory": {
    "format": " {}%",
    "interval": 5
  },
  "pulseaudio": {
    "format-source": " {volume}%",
    "format-source-muted": " 0%",
    "format": "{icon} {volume}% {format_source}",
    "format-muted": " 0% {format_source}",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "battery": {
    "bat": "BAT0",
    "interval": 10,
    "format-icons": ["", "", "", "", "", "", "", "", "", ""],
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%"
  },
  "network": {
    "interval": 3,
    "format-wifi": "  {essid}",
    "format-ethernet": " Connected",
    "format-disconnected": "",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\nUp: {bandwidthUpBits}\nDown: {bandwidthDownBits}"
  },
  "custom/menu": {
    "interval": 1,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/menu.sh"
  },
  "custom/hostname": {
    "exec": "echo \"$USER@$HOSTNAME\"",
    "on-click": "systemctl --user restart waybar"
  }
}
